<UserControl x:Class="WhatsLAN.App.Views.EmptyChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ChatBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 4 boutons d'actions rapides ronds (conformes aux captures de référence) -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Logo WhatsLAN en filigrane discret -->
            <Viewbox Width="80" Height="80" Opacity="0.35" Margin="0,0,0,32">
                <Grid Width="512" Height="512">
                    <Rectangle Width="512" Height="512" RadiusX="112" RadiusY="112" Fill="{DynamicResource Accent}"/>
                    <Path Data="M256 96c-88 0-160 64-160 144 0 32 12 62 32 86l-20 78 80-28c20 9 42 14 68 14 88 0 160-64 160-144S344 96 256 96z"
                          Fill="#FFFFFF"/>
                    <Line X1="190" Y1="236" X2="322" Y2="236" Stroke="{DynamicResource Accent}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="190" Y1="236" X2="256" Y2="304" Stroke="{DynamicResource Accent}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="322" Y1="236" X2="256" Y2="304" Stroke="{DynamicResource Accent}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Margin="164,210,0,0" Width="52" Height="52" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse Margin="296,210,0,0" Width="52" Height="52" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse Margin="230,278,0,0" Width="52" Height="52" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </Viewbox>

            <TextBlock Text="WhatsLAN pour Windows"
                       FontSize="26" FontWeight="Light"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Text="Communiquez en direct sur votre réseau local, sans serveur ni Internet."
                       FontSize="14" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,0,0,36"/>

            <!-- 4 boutons ronds -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- 1. Envoyer un document -->
                <StackPanel Width="110" Margin="10,0">
                    <Border Width="60" Height="60" CornerRadius="30"
                            Background="{DynamicResource RowSelected}"
                            Cursor="Hand">
                        <Path Width="24" Height="24" Stretch="Uniform"
                              Data="{StaticResource IconAttachment}"
                              Fill="{DynamicResource TextPrimary}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Envoyer un document"
                               FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <!-- 2. Ajouter un contact -->
                <StackPanel Width="110" Margin="10,0">
                    <Border Width="60" Height="60" CornerRadius="30"
                            Background="{DynamicResource RowSelected}"
                            Cursor="Hand">
                        <Path Width="24" Height="24" Stretch="Uniform"
                              Data="{StaticResource IconPlus}"
                              Fill="{DynamicResource TextPrimary}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ajouter un contact"
                               FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <!-- 3. Inviter un ami -->
                <StackPanel Width="110" Margin="10,0">
                    <Border Width="60" Height="60" CornerRadius="30"
                            Background="{DynamicResource RowSelected}"
                            Cursor="Hand">
                        <Path Width="24" Height="24" Stretch="Uniform"
                              Data="{StaticResource IconChannel}"
                              Fill="{DynamicResource TextPrimary}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Partager l'application"
                               FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <!-- 4. Créer un groupe -->
                <StackPanel Width="110" Margin="10,0">
                    <Border Width="60" Height="60" CornerRadius="30"
                            Background="{DynamicResource RowSelected}"
                            Cursor="Hand">
                        <Path Width="24" Height="24" Stretch="Uniform"
                              Data="{StaticResource IconCommunities}"
                              Fill="{DynamicResource TextPrimary}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Créer un groupe"
                               FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Bas : Chiffré de bout en bout -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Path Width="14" Height="14" Stretch="Uniform"
                  Data="{StaticResource IconLock}"
                  Fill="{DynamicResource TextSecondary}"
                  VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Vos messages personnels sont chiffrés de bout en bout"
                       FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
    </Grid>
</UserControl>
