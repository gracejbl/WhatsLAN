<UserControl x:Class="WhatsLAN.App.Views.ChatListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. En-tête Discussions + Boutons -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Champ de recherche en pilule -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Puces de filtre -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Liste des conversations -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. En-tête Discussions -->
        <Grid Grid.Row="0" Height="60" Margin="20,8,16,0">
            <TextBlock Text="Discussions"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Bouton Menu ⋮ -->
                <Button Style="{StaticResource IconButtonStyle}"
                        Width="36" Height="36" Margin="0,0,8,0"
                        ToolTip="Menu">
                    <Path Width="18" Height="18" Stretch="Uniform"
                          Data="{StaticResource IconMenuDots}"
                          Fill="{DynamicResource TextSecondary}"/>
                </Button>

                <!-- Gros bouton rond vert Nouvelle discussion -->
                <Button Command="{Binding NewChatCommand}"
                        Width="38" Height="38"
                        Cursor="Hand" ToolTip="Nouvelle discussion"
                        FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{DynamicResource Accent}"
                                    CornerRadius="19">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Data="{StaticResource IconPlus}"
                                      Fill="#FFFFFF"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Barre de recherche en pilule -->
        <Border Grid.Row="1" Height="40" Margin="16,4,16,8"
                Background="{DynamicResource SearchField}"
                CornerRadius="20">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                      Data="{StaticResource IconSearch}"
                      Fill="{DynamicResource TextSecondary}"
                      VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource Accent}"
                         VerticalContentAlignment="Center"
                         FontSize="14"/>

                <!-- Placeholder si texte vide -->
                <TextBlock Grid.Column="1"
                           Text="Rechercher ou démarrer une discussion"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="14" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisConverter}}"/>
            </Grid>
        </Border>

        <!-- 3. Puces de filtre (pilules) -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding FilterPills}" Margin="16,0,16,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Height="32" CornerRadius="16" Margin="0,0,8,0" Padding="14,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource FilterPillUnselectedBg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource FilterPillSelectedBg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource FilterPillUnselectedFg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource FilterPillSelectedFg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Compteur de non-lus pour la puce -->
                            <TextBlock Text="{Binding Count, StringFormat=' ({0})'}"
                                       FontSize="12" Margin="3,0,0,0"
                                       Visibility="{Binding HasCount, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource FilterPillUnselectedFg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource FilterPillSelectedFg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 4. Liste des conversations ou message si vide -->
        <Grid Grid.Row="3">
            <!-- Message si aucune discussion -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0"
                        Visibility="{Binding HasChats, Converter={StaticResource InverseBoolToVisConverter}}">
                <TextBlock Text="Aucune discussion."
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Cliquez sur ➕ pour commencer."
                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <ListBox ItemsSource="{Binding Chats}"
                     SelectedItem="{Binding SelectedChat}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding HasChats, Converter={StaticResource BoolToVisConverter}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="10,2"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="itemBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="12" Padding="10,8">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource RowHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource RowSelected}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="58">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar rond 48px avec anneau statut éventuel -->
                        <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center">
                            <!-- Anneau statut si actif -->
                            <Ellipse Width="48" Height="48"
                                     Stroke="{DynamicResource StatusRingUnseen}"
                                     StrokeThickness="2"
                                     Visibility="{Binding HasUnseenStatus, Converter={StaticResource BoolToVisConverter}}"/>

                            <!-- Disque avatar -->
                            <Ellipse Width="42" Height="42" Fill="{DynamicResource Accent}"/>
                            <TextBlock Text="{Binding AvatarInitial}"
                                       Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Point en ligne (si actif) -->
                            <Ellipse Width="10" Height="10"
                                     Fill="{DynamicResource AccentLight}"
                                     Stroke="{DynamicResource PanelBackground}" StrokeThickness="2"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisConverter}}"/>
                        </Grid>

                        <!-- Détails : Nom, Heure, Aperçu, Badges -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ligne 1 : Nom et Heure -->
                            <Grid Grid.Row="0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,60,0"/>

                                <TextBlock Text="{Binding LastMessageTime}"
                                           FontSize="12" HorizontalAlignment="Right"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentLight}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Ligne 2 : Aperçu du message et icônes d'état -->
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,50,0">
                                    <!-- Coche d'accusé si message envoyé par moi -->
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          Margin="0,0,4,0" VerticalAlignment="Center"
                                          Data="{Binding LastMessageStatus, Converter={StaticResource StatusToGeometryConverter}}"
                                          Fill="{Binding LastMessageStatus, Converter={StaticResource TicksColorConverter}}"
                                          Visibility="{Binding LastMessageStatus, Converter={StaticResource NullOrEmptyToVisConverter}}"/>

                                    <TextBlock Text="{Binding DisplayLastMessage}"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTyping}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentLight}"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Badges à droite (Épingle, Sourdine, Compteur non-lus) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Sourdine -->
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          Data="{StaticResource IconMute}"
                                          Fill="{DynamicResource TextSecondary}"
                                          Margin="0,0,6,0"
                                          Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisConverter}}"/>

                                    <!-- Épingle -->
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          Data="{StaticResource IconPin}"
                                          Fill="{DynamicResource TextSecondary}"
                                          Margin="0,0,6,0"
                                          Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisConverter}}"/>

                                    <!-- Badge vert non-lus -->
                                    <Border Background="{DynamicResource AccentLight}"
                                            CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="{Binding UnreadCount}"
                                                   Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Grid>
</UserControl>
