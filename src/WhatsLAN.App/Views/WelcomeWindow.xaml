<Window x:Class="WhatsLAN.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue sur WhatsLAN"
        Height="620" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="36,24">
        <Grid.RowDefinitions>
            <!-- Logo et En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Avatar -->
            <RowDefinition Height="Auto"/>
            <!-- Champs Pseudo et Statut -->
            <RowDefinition Height="Auto"/>
            <!-- Bouton Commencer -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo et Titres -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Viewbox Width="80" Height="80" Margin="0,0,0,16">
                <Grid Width="512" Height="512">
                    <Rectangle Width="512" Height="512" RadiusX="112" RadiusY="112" Fill="{DynamicResource Accent}"/>
                    <Path Data="M256 96c-88 0-160 64-160 144 0 32 12 62 32 86l-20 78 80-28c20 9 42 14 68 14 88 0 160-64 160-144S344 96 256 96z"
                          Fill="#FFFFFF"/>
                    <Line X1="190" Y1="236" X2="322" Y2="236" Stroke="{DynamicResource Accent}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="190" Y1="236" X2="256" Y2="304" Stroke="{DynamicResource Accent}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="322" Y1="236" X2="256" Y2="304" Stroke="{DynamicResource Accent}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Margin="164,210,0,0" Width="52" Height="52" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse Margin="296,210,0,0" Width="52" Height="52" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse Margin="230,278,0,0" Width="52" Height="52" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </Viewbox>

            <TextBlock Text="Bienvenue sur WhatsLAN"
                       FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>

            <TextBlock Text="Discutez avec les personnes de votre réseau, sans serveur ni Internet."
                       FontSize="13" Foreground="{DynamicResource TextSecondary}"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
        </StackPanel>

        <!-- Avatar cliquable -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Border Width="96" Height="96" CornerRadius="48"
                    Background="{DynamicResource RowSelected}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                    Cursor="Hand">
                <Grid>
                    <Path Width="36" Height="36" Stretch="Uniform"
                          Data="{StaticResource IconCommunities}"
                          Fill="{DynamicResource TextSecondary}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Formulaire Pseudo et Statut -->
        <StackPanel Grid.Row="2" Margin="10,0">
            <!-- Label Pseudo -->
            <TextBlock Text="Votre pseudo"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>

            <Border Background="{DynamicResource SearchField}" CornerRadius="8" Height="42" Padding="12,0"
                    BorderThickness="1" BorderBrush="{DynamicResource Divider}">
                <TextBox Text="{Binding Pseudo, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource Accent}"
                         FontSize="14" VerticalContentAlignment="Center"
                         MaxLength="25"/>
            </Border>

            <!-- Message d'erreur pseudo -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource Danger}" FontSize="12" Margin="4,4,0,12"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"/>

            <!-- Label Statut / À propos -->
            <TextBlock Text="Statut / À propos"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,6"/>

            <Border Background="{DynamicResource SearchField}" CornerRadius="8" Height="42" Padding="12,0"
                    BorderThickness="1" BorderBrush="{DynamicResource Divider}">
                <TextBox Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource Accent}"
                         FontSize="14" VerticalContentAlignment="Center"
                         MaxLength="139"/>
            </Border>
        </StackPanel>

        <!-- Bouton Commencer -->
        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="10,0,10,12">
            <Button Command="{Binding SubmitCommand}"
                    Height="44" Cursor="Hand"
                    FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{DynamicResource Accent}" CornerRadius="8">
                            <TextBlock Text="Commencer"
                                       Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
