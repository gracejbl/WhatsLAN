<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette Thème Clair fidèle aux spécifications WhatsApp Desktop -->
    <SolidColorBrush x:Key="AppBackground" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelHeader" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="ChatBackground" Color="#EFEAE2"/>
    
    <SolidColorBrush x:Key="BubbleOut" Color="#D9FDD3"/>
    <SolidColorBrush x:Key="BubbleIn" Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="TextPrimary" Color="#111B21"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#667781"/>
    <SolidColorBrush x:Key="Accent" Color="#00A884"/>
    <SolidColorBrush x:Key="AccentLight" Color="#25D366"/>
    <SolidColorBrush x:Key="TickBlue" Color="#53BDEB"/>
    <SolidColorBrush x:Key="Divider" Color="#E9EDEF"/>
    
    <SolidColorBrush x:Key="RowHover" Color="#F5F6F6"/>
    <SolidColorBrush x:Key="RowSelected" Color="#F0F2F5"/>
    
    <SolidColorBrush x:Key="InputBar" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="InputField" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SearchField" Color="#F0F2F5"/>
    
    <SolidColorBrush x:Key="Danger" Color="#EA0038"/>
    <SolidColorBrush x:Key="LinkBlue" Color="#027EB5"/>
    
    <SolidColorBrush x:Key="SystemPill" Color="#FFFFFFE6"/>
    <SolidColorBrush x:Key="SystemPillText" Color="#54656F"/>
    
    <SolidColorBrush x:Key="StatusRingUnseen" Color="#25D366"/>
    <SolidColorBrush x:Key="StatusRingSeen" Color="#B1B8BC"/>
    
    <SolidColorBrush x:Key="ScrollBarThumb" Color="#B2B5B8"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="QuoteBackground" Color="#E8F5E9"/>

    <!-- Puce de filtre sélectionnée -->
    <SolidColorBrush x:Key="FilterPillSelectedBg" Color="#E7FCE3"/>
    <SolidColorBrush x:Key="FilterPillSelectedFg" Color="#00A884"/>
    <SolidColorBrush x:Key="FilterPillUnselectedBg" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="FilterPillUnselectedFg" Color="#667781"/>

</ResourceDictionary>
