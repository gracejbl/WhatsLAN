<Window x:Class="WhatsLAN.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WhatsLAN.App.Views"
        xmlns:viewmodels="clr-namespace:WhatsLAN.App.ViewModels"
        mc:Ignorable="d"
        Title="WhatsLAN"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        FontFamily="Segoe UI"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <!-- 1. Barre de titre personnalisée (38px) -->
            <RowDefinition Height="38"/>
            <!-- 2. Corps de l'application (Rail + Liste + Zone centrale) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Barre de titre personnalisée -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Logo et Nom de l'application à gauche -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                        <Grid Width="512" Height="512">
                            <Rectangle Width="512" Height="512" RadiusX="112" RadiusY="112" Fill="{DynamicResource Accent}"/>
                            <Path Data="M256 96c-88 0-160 64-160 144 0 32 12 62 32 86l-20 78 80-28c20 9 42 14 68 14 88 0 160-64 160-144S344 96 256 96z"
                                  Fill="#FFFFFF"/>
                            <Line X1="190" Y1="236" X2="322" Y2="236" Stroke="{DynamicResource Accent}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="190" Y1="236" X2="256" Y2="304" Stroke="{DynamicResource Accent}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="322" Y1="236" X2="256" Y2="304" Stroke="{DynamicResource Accent}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Margin="164,210,0,0" Width="52" Height="52" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Ellipse Margin="296,210,0,0" Width="52" Height="52" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Ellipse Margin="230,278,0,0" Width="52" Height="52" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </Viewbox>
                    <TextBlock Text="WhatsLAN"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Boutons Réduire / Agrandir / Fermer à droite -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="46" Height="38" Background="Transparent" BorderThickness="0"
                            Click="MinimizeButton_Click" ToolTip="Réduire"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}">
                                    <Path Data="M0,0 L10,0" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource RowHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Width="46" Height="38" Background="Transparent" BorderThickness="0"
                            Click="MaximizeButton_Click" ToolTip="Agrandir / Restaurer"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}">
                                    <Rectangle Width="10" Height="10" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource RowHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Width="46" Height="38" Background="Transparent" BorderThickness="0"
                            Click="CloseButton_Click" ToolTip="Fermer"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}">
                                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource Danger}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Corps principal de l'application -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Rail gauche 64px -->
                <ColumnDefinition Width="64"/>
                <!-- Panneau liste (défaut 400px, min 340, max 540) -->
                <ColumnDefinition Width="400" MinWidth="340" MaxWidth="540"/>
                <!-- GridSplitter discret 1px -->
                <ColumnDefinition Width="1"/>
                <!-- Zone centrale de discussion / état vide -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Rail gauche -->
            <views:NavRailView Grid.Column="0" DataContext="{Binding NavRail}"/>

            <!-- Panneau liste Discussions -->
            <views:ChatListView Grid.Column="1" DataContext="{Binding ChatList}"/>

            <!-- Splitter 1px redimensionnable -->
            <GridSplitter Grid.Column="2" Width="1"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Divider}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Zone centrale : Discussion active OU État vide -->
            <Grid Grid.Column="3">
                <!-- Vue de discussion si un chat est sélectionné -->
                <views:ChatView DataContext="{Binding CurrentChat}"
                                Visibility="{Binding DataContext.HasSelectedChat, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}"/>

                <!-- Vue état vide si aucun chat sélectionné -->
                <views:EmptyChatView Visibility="{Binding DataContext.HasSelectedChat, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
